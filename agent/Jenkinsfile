pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')            // 첫 이미지 빌드는 패키지가 커서 오래 걸림
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        DEPLOY_DIR = '/home/opc/project/2026-1-CECD1-3-tripleA-07'
    }

    stages {
        stage('Detect Changes') {
            steps {
                script {
                    def base
                    if (env.CHANGE_ID) {
                        sh "git fetch --no-tags origin +refs/heads/${env.CHANGE_TARGET}:refs/remotes/origin/${env.CHANGE_TARGET}"
                        base = "origin/${env.CHANGE_TARGET}"
                    } else if (env.BRANCH_NAME == 'main' && !env.GIT_PREVIOUS_SUCCESSFUL_COMMIT) {
                        // main에 성공한 빌드가 아직 없으면: 운영 폴더에 실제로 배포돼 있는 커밋과 비교
                        base = sh(script: "git -C ${env.DEPLOY_DIR} rev-parse HEAD", returnStdout: true).trim()
                    } else {
                        // 그 외: 마지막으로 성공한 빌드와 비교 (첫 빌드면 직전 커밋)
                        base = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: 'HEAD~1'
                    }
                    sh "git diff --name-only ${base}...HEAD"
                    def hit = sh(script: "git diff --name-only ${base}...HEAD | grep -qE '^(agent/|docker-compose.yml)'", returnStatus: true)
                    env.AGENT_CHANGED = (hit == 0) ? 'true' : 'false'
                    echo "AGENT_CHANGED=${env.AGENT_CHANGED}"
                }
            }
        }

        stage('Build Image') {
            when { environment name: 'AGENT_CHANGED', value: 'true' }
            steps {
                // requirements 설치까지 포함해 이미지가 정상적으로 만들어지는지 확인
                sh 'docker build -t triplea-agent:ci agent'
            }
        }

        stage('Static Analysis') {
            when { environment name: 'AGENT_CHANGED', value: 'true' }
            steps {
                // ruff는 운영 이미지에 넣지 않고, 검사할 때만 임시 컨테이너에 설치해서 실행
                // --exit-zero: 경고가 있어도 실패하지 않음 ("설정만")
                sh 'docker run --rm triplea-agent:ci sh -c "pip install -q ruff==0.8.4 && ruff check app --exit-zero --statistics"'
            }
        }

        stage('Syntax Check') {
            when { environment name: 'AGENT_CHANGED', value: 'true' }
            steps {
                // 만든 이미지 안에서 모든 .py 파일을 컴파일만 해봄 (문법 오류 검출, .env 없이도 가능)
                sh 'docker run --rm triplea-agent:ci python -m compileall -q app'
            }
        }

        stage('Approve Deploy') {
            when { allOf { branch 'main'; environment name: 'AGENT_CHANGED', value: 'true' } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'agent를 운영 서버에 배포할까요?', ok: 'Deploy'
                }
            }
        }

        stage('Deploy') {
            when { allOf { branch 'main'; environment name: 'AGENT_CHANGED', value: 'true' } }
            steps {
                // api와 agent가 같은 잠금을 공유 -> 동시에 배포하지 않음
                lock('triplea-deploy') {
                    dir(env.DEPLOY_DIR) {
                        sh '''
                            git fetch origin main
                            if [ "$(git rev-parse HEAD)" != "$GIT_COMMIT" ] && git merge-base --is-ancestor "$GIT_COMMIT" HEAD; then
                                echo "더 최신 커밋이 이미 배포되어 있어 이 빌드는 배포하지 않습니다."
                                exit 1
                            fi
                            git merge --ff-only "$GIT_COMMIT"
                            docker compose up -d --build --no-deps agent
                        '''
                    }
                }
            }
        }
    }
}