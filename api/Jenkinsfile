pipeline {
    agent any

    options {
        timeout(time: 40, unit: 'MINUTES')            // 빌드가 40분 넘으면 강제 종료
        disableConcurrentBuilds()                      // 같은 브랜치 빌드는 한 번에 하나만
        buildDiscarder(logRotator(numToKeepStr: '20')) // 빌드 기록은 최근 20개만 보관
    }

    environment {
        DEPLOY_DIR = '/home/opc/project/2026-1-CECD1-3-tripleA-07'
    }

    stages {
        // 이번 변경에 api/ 또는 docker-compose.yml이 포함됐는지 확인
        stage('Detect Changes') {
            steps {
                script {
                    def base
                    if (env.CHANGE_ID) {
                        // PR 빌드: PR의 대상 브랜치(보통 main)와 비교
                        sh "git fetch --no-tags origin +refs/heads/${env.CHANGE_TARGET}:refs/remotes/origin/${env.CHANGE_TARGET}"
                        base = "origin/${env.CHANGE_TARGET}"
                    } else {
                        // 브랜치 빌드: 마지막으로 성공한 빌드와 비교 (첫 빌드면 직전 커밋)
                        base = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: 'HEAD~1'
                    }
                    sh "git diff --name-only ${base}...HEAD"
                    def hit = sh(script: "git diff --name-only ${base}...HEAD | grep -qE '^(api/|docker-compose.yml)'", returnStatus: true)
                    env.API_CHANGED = (hit == 0) ? 'true' : 'false'
                    echo "API_CHANGED=${env.API_CHANGED}"
                }
            }
        }
        
        stage('Static Analysis') {
            when { environment name: 'API_CHANGED', value: 'true' }
            steps {
                dir('api') {
                    // ignoreFailures = true라서 경고가 있어도 빌드는 실패하지 않음
                    sh './gradlew checkstyleMain --no-daemon'
                }
            }
            post {
                always {
                    // 보고서를 빌드 결과에 첨부 (다음 Build 단계의 clean이 지우기 전에 보관)
                    archiveArtifacts artifacts: 'api/build/reports/checkstyle/*', allowEmptyArchive: true
                }
            }
        }

        stage('Build') {
            when { environment name: 'API_CHANGED', value: 'true' }
            steps {
                dir('api') {
                    sh './gradlew clean bootJar --no-daemon'
                }
            }
        }

        stage('Test') {
            when { environment name: 'API_CHANGED', value: 'true' }
            steps {
                dir('api') {
                    // TripleaApplicationTests(contextLoads)는 실DB가 필요해서 제외, advertisement 테스트는 H2로 실행
                    sh "./gradlew test --tests 'com.capstone.triplea.advertisement.*' --no-daemon"
                }
            }
        }

        stage('Approve Deploy') {
            when { allOf { branch 'main'; environment name: 'API_CHANGED', value: 'true' } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'api를 운영 서버에 배포할까요?', ok: 'Deploy'
                }
            }
        }

        stage('Deploy') {
            when { allOf { branch 'main'; environment name: 'API_CHANGED', value: 'true' } }
            steps {
                // api와 agent가 같은 잠금을 공유 -> 동시에 배포하지 않음
                lock('triplea-deploy') {
                    dir(env.DEPLOY_DIR) {
                        sh '''
                            git fetch origin main
                            if [ "$(git rev-parse HEAD)" != "$GIT_COMMIT" ] && git merge-base --is-ancestor "$GIT_COMMIT" HEAD; then
                                echo "더 최신 커밋이 이미 배포되어 있어 이 빌드는 배포하지 않습니다."
                                exit 1
                            fi
                            git merge --ff-only "$GIT_COMMIT"
                            docker compose up -d --build --no-deps api
                        '''
                    }
                }
            }
        }
    }
}